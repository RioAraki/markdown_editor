{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/scripts/sync-agent-docs.mjs\"",
            "statusMessage": "Syncing AGENTS.md from CLAUDE.md",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
